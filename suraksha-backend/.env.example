PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Local development can use either one officer pair or an officers file.
SURAKSHA_OFFICER_ID=
SURAKSHA_OFFICER_PASSWORD=
SURAKSHA_OFFICER_NAME=
SURAKSHA_OFFICER_ROLE=control-room
SURAKSHA_OFFICERS_FILE=config/officers.json

# Required in production. Optional in development; a runtime-only secret is generated if omitted.
JWT_SECRET=

# Production database. If omitted, the JSON store at data/data.json is used.
MONGO_URI=

# Production frontend origin for CORS.
FRONTEND_URL=

# Optional Phase 3/4 integrations.
PINATA_JWT=
PINATA_API_KEY=
PINATA_SECRET_KEY=
POLYGON_RPC_URL=
POLYGON_PRIVATE_KEY=
POLYGON_REGISTRY_ADDRESS=
UPSTASH_REDIS_URL=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
